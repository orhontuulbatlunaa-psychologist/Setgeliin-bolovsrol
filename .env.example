# Сервер талд Vercel Project Settings > Environment Variables хэсэгт оруулна.
# Эдгээр утгыг GitHub руу бодитоор commit хийж болохгүй.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Урт, давтагдашгүй админ нууц үг болон 32+ тэмдэгтийн session secret.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=Сэтгэлийн боловсрол <reports@YOUR_VERIFIED_DOMAIN>
ADMIN_NOTIFY_EMAIL=admin@YOUR_DOMAIN

# Тестийн production origin. CORS болон origin шалгалтад хэрэглэнэ.
APP_ORIGIN=https://YOUR_DOMAIN
